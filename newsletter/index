<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>La Lettre Patrimoniale — EcloRes</title>
  <meta name="description" content="Chaque mois, une lettre sur l'actualité patrimoniale, fiscale et immobilière. Sans jargon, directement utile." />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --vert:       #597d6e;
      --vert-fonce: #045952;
      --gris:       #8a9a94;
      --noir:       #1a1a1a;
      --creme:      #f7f5f0;
      --blanc:      #ffffff;
      --or:         #b89a6a;
      --texte:      #2d2d2d;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      color: var(--texte);
      background: var(--creme);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* NAV */
    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.4rem 3rem;
      background: rgba(247,245,240,0.95);
      border-bottom: 1px solid rgba(89,125,110,0.12);
    }
    .nav-logo img { height: 34px; display: block; }
    .nav-back {
      font-size: .8rem;
      color: var(--gris);
      text-decoration: none;
      letter-spacing: .05em;
      transition: color .2s;
    }
    .nav-back:hover { color: var(--vert-fonce); }

    /* HERO */
    .hero {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: calc(100vh - 68px);
    }

    .hero-left {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 5rem 4rem 5rem 5rem;
      position: relative;
    }
    .hero-left::after {
      content: '';
      position: absolute;
      top: 10%; right: 0;
      width: 1px;
      height: 80%;
      background: linear-gradient(to bottom, transparent, rgba(89,125,110,.3), transparent);
    }

    .eyebrow {
      font-size: .72rem;
      font-weight: 500;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--or);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: .6rem;
    }
    .eyebrow::before {
      content: '';
      display: inline-block;
      width: 24px;
      height: 1px;
      background: var(--or);
    }

    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.8rem, 4vw, 4.2rem);
      font-weight: 300;
      line-height: 1.1;
      color: var(--noir);
      margin-bottom: 1.4rem;
    }
    .hero-title em {
      font-style: italic;
      color: var(--vert-fonce);
    }

    .hero-desc {
      font-size: 1rem;
      color: #666;
      line-height: 1.8;
      max-width: 440px;
      margin-bottom: 2.5rem;
    }

    .topics {
      display: flex;
      flex-direction: column;
      gap: .75rem;
      margin-bottom: 2.5rem;
    }
    .topic-item {
      display: flex;
      align-items: center;
      gap: .75rem;
      font-size: .9rem;
      color: var(--texte);
    }
    .topic-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--vert);
      flex-shrink: 0;
    }

    .signature {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(89,125,110,.15);
    }
    .signature-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      overflow: hidden;
      flex-shrink: 0;
      border: 1px solid rgba(89,125,110,.2);
    }
    .signature-avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center 10%; }
    .signature-name {
      font-size: .88rem;
      font-weight: 500;
      color: var(--noir);
    }
    .signature-role {
      font-size: .78rem;
      color: var(--gris);
      margin-top: 2px;
    }

    /* FORM SIDE */
    .hero-right {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 5rem 4rem 4rem;
      background: var(--blanc);
    }

    .form-card {
      width: 100%;
      max-width: 400px;
    }

    .form-tag {
      display: inline-block;
      font-size: .7rem;
      font-weight: 500;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--vert);
      background: rgba(89,125,110,.08);
      padding: .35rem .9rem;
      border-radius: 2px;
      margin-bottom: 1.5rem;
    }

    .form-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.9rem;
      font-weight: 300;
      color: var(--noir);
      line-height: 1.25;
      margin-bottom: .75rem;
    }

    .form-sub {
      font-size: .88rem;
      color: #888;
      line-height: 1.65;
      margin-bottom: 2rem;
    }

    .field { margin-bottom: 1rem; }
    .field label {
      display: block;
      font-size: .75rem;
      font-weight: 500;
      letter-spacing: .05em;
      color: var(--gris);
      margin-bottom: .4rem;
      text-transform: uppercase;
    }
    .field input {
      width: 100%;
      padding: .9rem 1.1rem;
      border: 1px solid rgba(89,125,110,.2);
      border-radius: 2px;
      font-family: 'DM Sans', sans-serif;
      font-size: .92rem;
      color: var(--texte);
      background: var(--blanc);
      outline: none;
      transition: border-color .2s;
    }
    .field input:focus { border-color: var(--vert); }

    .btn-submit {
      width: 100%;
      padding: 1rem;
      background: var(--vert-fonce);
      color: var(--blanc);
      border: none;
      border-radius: 2px;
      font-family: 'DM Sans', sans-serif;
      font-size: .92rem;
      font-weight: 500;
      cursor: pointer;
      transition: background .2s, transform .1s;
      margin-top: .5rem;
      letter-spacing: .02em;
    }
    .btn-submit:hover { background: var(--vert); }
    .btn-submit:active { transform: scale(.99); }

    .success-msg {
      display: none;
      text-align: center;
      padding: 1.5rem;
      background: rgba(89,125,110,.06);
      border: 1px solid rgba(89,125,110,.2);
      border-radius: 2px;
      margin-top: 1rem;
    }
    .success-msg p:first-child {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 400;
      color: var(--vert-fonce);
      margin-bottom: .4rem;
    }
    .success-msg p:last-child {
      font-size: .82rem;
      color: var(--gris);
    }

    .form-legal {
      font-size: .72rem;
      color: #bbb;
      line-height: 1.6;
      margin-top: 1rem;
      text-align: center;
    }

    .form-divider {
      display: flex;
      align-items: center;
      gap: .75rem;
      margin: 1.5rem 0;
    }
    .form-divider::before, .form-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: rgba(89,125,110,.12);
    }
    .form-divider span {
      font-size: .72rem;
      color: #ccc;
      letter-spacing: .05em;
      text-transform: uppercase;
    }

    .social-proof {
      display: flex;
      align-items: center;
      gap: .6rem;
      font-size: .78rem;
      color: var(--gris);
      justify-content: center;
    }
    .social-proof-dots {
      display: flex;
      gap: -4px;
    }
    .social-dot {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--creme);
      border: 1.5px solid var(--blanc);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      color: var(--vert-fonce);
      font-weight: 500;
      margin-left: -6px;
    }
    .social-dot:first-child { margin-left: 0; }

    /* FOOTER */
    footer {
      background: var(--noir);
      padding: 1.5rem 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .footer-left {
      font-size: .75rem;
      color: rgba(255,255,255,.3);
    }
    .footer-right {
      display: flex;
      gap: 1.5rem;
    }
    .footer-right a {
      font-size: .75rem;
      color: rgba(255,255,255,.35);
      text-decoration: none;
      transition: color .2s;
    }
    .footer-right a:hover { color: rgba(255,255,255,.7); }

    /* ANIMATIONS */
    .fade-in {
      opacity: 0;
      transform: translateY(16px);
      animation: fadeIn .5s ease forwards;
    }
    @keyframes fadeIn {
      to { opacity: 1; transform: translateY(0); }
    }
    .delay-1 { animation-delay: .1s; }
    .delay-2 { animation-delay: .2s; }
    .delay-3 { animation-delay: .3s; }
    .delay-4 { animation-delay: .4s; }
    .delay-5 { animation-delay: .5s; }

    /* RESPONSIVE */
    @media (max-width: 860px) {
      nav { padding: 1rem 1.5rem; }
      .hero { grid-template-columns: 1fr; min-height: auto; }
      .hero-left { padding: 3rem 1.5rem 2rem; }
      .hero-left::after { display: none; }
      .hero-right { padding: 2rem 1.5rem 3rem; background: var(--creme); }
      footer { padding: 1.5rem; flex-direction: column; text-align: center; }
    }
  </style>
</head>
<body>

  <nav>
    <a class="nav-logo" href="/">
      <img src="/logo-eclores.png" alt="EcloRes" />
    </a>
    <a class="nav-back" href="/">← Retour au site</a>
  </nav>

  <div class="hero">

    <div class="hero-left">
      <div class="eyebrow fade-in">Lettre mensuelle</div>
      <h1 class="hero-title fade-in delay-1">L'actualité<br>patrimoniale<br><em>qui compte.</em></h1>
      <p class="hero-desc fade-in delay-2">Chaque mois, une lettre pensée pour les particuliers actifs qui veulent comprendre les enjeux fiscaux, patrimoniaux et immobiliers — sans perdre de temps.</p>

      <div class="topics fade-in delay-3">
        <div class="topic-item">
          <div class="topic-dot"></div>
          Évolutions fiscales et ce qu'elles changent pour vous
        </div>
        <div class="topic-item">
          <div class="topic-dot"></div>
          Stratégies patrimoniales concrètes et actionnables
        </div>
        <div class="topic-item">
          <div class="topic-dot"></div>
          Immobilier, retraite, transmission — sans jargon
        </div>
        <div class="topic-item">
          <div class="topic-dot"></div>
          Les erreurs à éviter et les leviers à activer
        </div>
      </div>

      <div class="signature fade-in delay-4">
        <div class="signature-avatar">
          <img src="/matthieu-lecocq.jpg" alt="Matthieu Lecocq" />
        </div>
        <div>
          <div class="signature-name">Matthieu Lecocq</div>
          <div class="signature-role">Conseiller en Gestion de Patrimoine indépendant — Bordeaux</div>
        </div>
      </div>
    </div>

    <div class="hero-right">
      <div class="form-card">
        <div class="form-tag fade-in">Inscription gratuite</div>
        <h2 class="form-title fade-in delay-1">Rejoignez<br>la lettre</h2>
        <p class="form-sub fade-in delay-2">Un email par mois. Pas de spam. Désabonnement en un clic.</p>

        <div class="fade-in delay-3">
          <div class="field">
            <label>Prénom</label>
            <input type="text" id="prenom" placeholder="Marie" autocomplete="given-name" />
          </div>
          <div class="field">
            <label>Email</label>
            <input type="email" id="email" placeholder="marie@exemple.fr" autocomplete="email" />
          </div>
          <button class="btn-submit" onclick="subscribe()">S'abonner à la lettre →</button>

          <div class="success-msg" id="success">
            <p>Bienvenue !</p>
            <p>Votre inscription est confirmée. Le prochain numéro arrive bientôt.</p>
          </div>

          <div class="form-divider"><span>ou</span></div>

          <div class="social-proof">
            <div class="social-proof-dots">
              <div class="social-dot">ML</div>
              <div class="social-dot">AR</div>
              <div class="social-dot">PD</div>
              <div class="social-dot">CB</div>
            </div>
            Rejoignez les abonnés déjà inscrits
          </div>

          <p class="form-legal">Données confidentielles — conformément au RGPD, vous pouvez demander leur suppression à tout moment à matthieulecocq@eclorespatrimoine.fr</p>
        </div>
      </div>
    </div>

  </div>

  <footer>
    <div class="footer-left">© EcloRes — Conseil en Gestion de Patrimoine</div>
    <div class="footer-right">
      <a href="/">Site principal</a>
      <a href="/quiz">Diagnostic patrimonial</a>
      <a href="https://calendly.com/matthieulecocq-eclorespatrimoine/45min" target="_blank">Bilan offert</a>
    </div>
  </footer>

  <script>
    async function subscribe() {
      const prenom = document.getElementById("prenom").value.trim();
      const email = document.getElementById("email").value.trim();

      if (!prenom || !email.includes("@")) {
        document.getElementById("prenom").style.borderColor = !prenom ? "#c0392b" : "";
        document.getElementById("email").style.borderColor = !email.includes("@") ? "#c0392b" : "";
        return;
      }

      const btn = document.querySelector(".btn-submit");
      btn.textContent = "Inscription en cours...";
      btn.disabled = true;

      try {
        await fetch("/api/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ prenom, email })
        });
        document.getElementById("success").style.display = "block";
        btn.style.display = "none";
        document.getElementById("prenom").style.display = "none";
        document.getElementById("email").style.display = "none";
        document.querySelector(".field:first-child label").style.display = "none";
        document.querySelector(".field:last-of-type label").style.display = "none";
      } catch(e) {
        btn.textContent = "S'abonner à la lettre →";
        btn.disabled = false;
      }
    }
  </script>

</body>
</html>
